{
  "name": "scanruler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Stefan Hermann (CNC Kitchen) <stefan@cnckitchen.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNCKitchen/scanruler.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx --yes wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "e2e:align": "node scripts/e2e-align.mjs",
    "e2e:align-live": "node scripts/e2e-align-live.mjs",
    "e2e:nav": "node scripts/e2e-nav.mjs",
    "e2e:touch": "node scripts/e2e-touch.mjs",
    "e2e:edit": "node scripts/e2e-edit.mjs",
    "e2e:paint": "node scripts/e2e-paint.mjs",
    "e2e:extend": "node scripts/e2e-extend.mjs",
    "e2e:deviation": "node scripts/e2e-deviation.mjs",
    "e2e:element-deviation": "node scripts/e2e-element-deviation.mjs",
    "e2e:thickness": "node scripts/e2e-thickness.mjs",
    "e2e:step": "node scripts/e2e-step.mjs",
    "e2e:local-fit": "node scripts/e2e-local-fit.mjs"
  },
  "dependencies": {
    "meshstep": "0.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.8.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.6.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
